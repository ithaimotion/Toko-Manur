{
  "manifest_version": 3,
  "name": "Toko Manur Review Sync",
  "version": "1.0",
  "description": "Ekstensi untuk menarik review produk Shopee secara otomatis ke Toko Manur.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://shopee.co.id/*",
    "https://*.tokopedia.com/*",
    "https://*.lazada.co.id/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Reviews"
  }
}
