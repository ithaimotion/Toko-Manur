generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String     @default("12345678")
  role      Role       @default(EDITOR)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  blogs     Blog[]
  activities UserActivity[]

  @@map("users")
}

model ResetRequest {
  id        String        @id @default(cuid())
  email     String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("reset_requests")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("user_activities")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model CompanyProfile {
  id             String   @id @default(cuid())
  about          String   @db.Text
  vision         String
  mission        Json
  values         Json
  brandStory     String   @db.Text
  founded        String
  legalDocuments Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("company_profile")
}

model ContactInfo {
  id              String   @id @default(cuid())
  address         String   @db.Text
  email           String
  whatsapp        String
  whatsappMessage String?  @db.Text
  googleMapsEmbed String?  @db.Text
  latitude        String?
  longitude       String?
  businessHours   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contact_info")
}

enum Marketplace {
  SHOPEE
  TOKOPEDIA
  LAZADA
}

model Review {
  id          String      @id @default(cuid())
  marketplace Marketplace
  reviewId    String      @unique
  productName String
  username    String
  rating      Int
  comment     String?     @db.Text
  reviewDate  DateTime
  images      Json?
  videos      Json?
  featured    Boolean     @default(false)
  category    String?
  sentiment   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("marketplace_reviews")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]

  @@map("blog_categories")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImage     String?
  seoTitle       String?
  seoDescription String?       @db.Text
  status         BlogStatus    @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int           @default(5)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           Json?         // Store array of strings
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("blogs")
}

model Promo {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  description     String?   @db.Text
  image           String?
  badgeText       String?
  ctaText         String?
  ctaUrl          String?
  backgroundColor String?
  isActive        Boolean   @default(true)
  order           Int       @default(0)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("promos")
}

model MarketplaceLink {
  id          String   @id @default(cuid())
  platform    String
  name        String
  url         String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("marketplace_links")
}

model HeroBanner {
  id               String   @id @default(cuid())
  title            String
  subtitle         String
  description      String?  @db.Text
  image            String?
  ctaText          String?
  ctaUrl           String?
  ctaSecondaryText String?
  ctaSecondaryUrl  String?
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  carouselItems    HeroCarouselItem[]

  @@map("hero_banners")
}

model HeroCarouselItem {
  id           String     @id @default(cuid())
  heroBannerId String
  heroBanner   HeroBanner @relation(fields: [heroBannerId], references: [id], onDelete: Cascade)
  marketplace  String
  image        String
  trustCount   String
  rating       String
  isActive     Boolean    @default(true)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("hero_carousel_items")
}
