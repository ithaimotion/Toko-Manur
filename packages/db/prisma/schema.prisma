generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String     @default("12345678")
  role      Role       @default(EDITOR)
  status    UserStatus @default(ACTIVE)
  lastLogin DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  blogs     Blog[]

  @@map("users")
}

model ResetRequest {
  id        String        @id @default(cuid())
  email     String
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("reset_requests")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model CompanyProfile {
  id             String   @id @default(cuid())
  about          String   @db.Text
  vision         String
  mission        Json
  values         Json
  brandStory     String   @db.Text
  founded        String
  legalDocuments Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("company_profile")
}

model ContactInfo {
  id              String   @id @default(cuid())
  address         String   @db.Text
  email           String
  whatsapp        String
  whatsappMessage String?  @db.Text
  googleMapsEmbed String?  @db.Text
  latitude        String?
  longitude       String?
  businessHours   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contact_info")
}

enum Marketplace {
  SHOPEE
  TOKOPEDIA
  LAZADA
}

model Review {
  id          String      @id @default(cuid())
  marketplace Marketplace
  reviewId    String      @unique
  productName String
  username    String
  rating      Int
  comment     String?     @db.Text
  reviewDate  DateTime
  images      Json?
  videos      Json?
  featured    Boolean     @default(false)
  category    String?
  sentiment   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("marketplace_reviews")
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]

  @@map("blog_categories")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @db.Text
  content        String        @db.Text
  coverImage     String?
  seoTitle       String?
  seoDescription String?       @db.Text
  status         BlogStatus    @default(DRAFT)
  publishedAt    DateTime?
  readingTime    Int           @default(5)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  tags           Json?         // Store array of strings
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("blogs")
}
